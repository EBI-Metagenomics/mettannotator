#!/usr/bin/env python3
import argparse
import gzip
from pathlib import Path

from Bio import SeqIO

SUPPORTED_FASTA_EXTS = {".fasta", ".fa", ".fna"}
SUPPORTED_GBK_EXTS = {".gbk", ".gb", ".genbank"}
SUPPORTED_GFF_EXTS = {".gff", ".gff3", ".gff.gz"}

def read_map(map_file):
    mapping = {}
    with open(map_file) as f:
        for line in f:
            if not line.strip():
                continue
            old, new = line.strip().split("\t")
            mapping[old] = new
    return mapping

def rename_fasta(infile, outfile, mapping=None):
    records = []
    for i, rec in enumerate(SeqIO.parse(infile, "fasta"), 1):
        if mapping:
            try:
                new_id = mapping[rec.id]
            except KeyError:
                raise KeyError(f"Contig ID '{rec.id}' not found in mapping file.")
        else:
            new_id = f"contig_{i}"
        rec.id = new_id
        rec.name = new_id
        rec.description = ""
        records.append(rec)
    SeqIO.write(records, outfile, "fasta")

def rename_gbk(infile, outfile, mapping=None):
    records = []
    for i, rec in enumerate(SeqIO.parse(infile, "genbank"), 1):
        if mapping:
            try:
                new_id = mapping[rec.id]
            except KeyError:
                raise KeyError(f"Contig ID '{rec.id}' not found in mapping file.")
        else:
            new_id = f"contig_{i}"
        rec.id = new_id
        rec.name = new_id
        rec.description = ""
        rec.annotations["source"] = new_id
        if "contig" in rec.annotations:
            rec.annotations["contig"] = new_id
        for feat in rec.features:
            if "locus_tag" in feat.qualifiers:
                feat.qualifiers["locus_tag"] = [
                    tag.replace(rec.id, new_id) for tag in feat.qualifiers["locus_tag"]
                ]
        records.append(rec)
    SeqIO.write(records, outfile, "genbank")

def rename_gff(infile, outfile, mapping=None):
    opener = gzip.open if infile.endswith(".gz") else open
    cache = {}
    counter = 1
    with opener(infile, "rt") as f_in, open(outfile, "w") as f_out:
        for line in f_in:
            if line.startswith("#"):
                f_out.write(line)
                continue
            columns = line.strip().split("\t")
            if len(columns) < 9:
                f_out.write(line)
                continue
            seqid = columns[0]
            if mapping:
                try:
                    new_id = mapping[seqid]
                except KeyError:
                    raise KeyError(f"Contig ID '{seqid}' not found in mapping file.")
            else:
                if seqid not in cache:
                    cache[seqid] = f"contig_{counter}"
                    counter += 1
                new_id = cache[seqid]
            columns[0] = new_id
            f_out.write("\t".join(columns) + "\n")


def main():
    parser = argparse.ArgumentParser(
        description="Rename contigs in FASTA, GenBank, or GFF files"
    )
    parser.add_argument("infiles", nargs="+", help="Input files (.fasta/.fa/.fna, .gbk, .gff[.gz])")
    parser.add_argument("-o", "--outdir", required=True, help="Output directory")
    parser.add_argument("--map", help="Mapping TSV file (2 columns: old_name new_name)")
    args = parser.parse_args()

    Path(args.outdir).mkdir(parents=True, exist_ok=True)

    # Read mapping if provided
    if args.map:
        mapping = {}
        with open(args.map) as f:
            for line in f:
                if not line.strip():
                    continue
                old, new = line.strip().split("\t")
                mapping[old] = new
    else:
        mapping = None

    # Rename contigs in each input file depending on its type
    for infile in args.infiles:
        ext = "".join(Path(infile).suffixes).lower()
        outpath = Path(args.outdir) / Path(infile).name
        if ext.endswith(SUPPORTED_FASTA_EXTS):
            rename_fasta(infile, outpath, mapping)
        elif ext.endswith(SUPPORTED_GBK_EXTS):
            rename_gbk(infile, outpath, mapping)
        elif ext.endswith(SUPPORTED_GFF_EXTS):
            rename_gff(infile, outpath, mapping)
        else:
            raise ValueError(
                            f"Unrecognized file type for: {infile}. "
                            f"Supported extensions: {SUPPORTED_FASTA_EXTS | SUPPORTED_GBK_EXTS | SUPPORTED_GFF_EXTS}"
                            )
        print(f"✔ Renamed {infile} → {outpath}")

if __name__ == "__main__":
    main()
