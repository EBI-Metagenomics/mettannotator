process DIAMOND_GETDB {

    tag "DIAMOND ${db_name} ${version}"

    label 'process_long'

    container "${ workflow.containerEngine in ['singularity', 'apptainer'] ?
        'https://depot.galaxyproject.org/singularity/gnu-wget:1.18--h36e9172_9' :
        'biocontainers/gnu-wget:1.18--h36e9172_9' }"

    publishDir "${params.dbs}", mode: "copy"

    input:
    val db_name
    val version

    output:
    tuple path("${db_name}/db.filtered.dmnd"), val(version), emit: diamond_uniref_db
    path "${db_name}/VERSION.txt",                           emit: db_version_file
    path "${db_name}/protnlm_filter_stats.txt",              emit: stats

    script:
    // Generated by --generate_uniref_protnlm_db in EBI-Metagenomics/reference-databases-preprocessing-pipeline
    // and hosted by us, as UniProt only serves the current release
    def hosted = "https://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/${db_name}_protnlm_filtered"
    def tarball = "${db_name}_protnlm_filtered_${version}.tar.gz"
    """
    if ! wget -q --spider "${hosted}/${tarball}"; then
        echo "${db_name} release ${version} is not hosted. Available releases: ${hosted}/" >&2
        exit 1
    fi

    mkdir -p ${db_name}
    wget -qO- "${hosted}/${tarball}" | tar -xzf - -C ${db_name}

    if [ "\$(cat ${db_name}/VERSION.txt)" != "${version}" ]; then
        echo "${tarball} contains release \$(cat ${db_name}/VERSION.txt), expected ${version}" >&2
        exit 1
    fi
    """
}
